# Primary provider: groq | gemini | openrouter | inference
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen3-30b-a3b-instruct-2507

# Fallback provider, tried if the primary call fails (blank = no fallback)
LLM_FALLBACK_PROVIDER=

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Generic OpenAI-compatible endpoint used by LLM_PROVIDER=inference
INFERENCE_BASE_URL=
INFERENCE_API_KEY=
INFERENCE_MODEL=
# Reasoning models spend part of this budget on hidden thinking before
# answering; too low and the reply comes back empty. Default 4000.
INFERENCE_MAX_TOKENS=4000

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One CSV row per request, appended. Relative to the backend/ directory.
RUN_LOG_PATH=logs/runs.csv

# How many results are researched/explained concurrently. Raising this speeds
# up large panels but risks provider rate limits (and NCBI throttling PubMed).
EXPLAIN_CONCURRENCY=4


DATABASE_URL=
# uncomment next line if you use Prisma <5.10
# DATABASE_URL_UNPOOLED="postgresql://user:password@host/database?sslmode=require"


# OpenRouter completion ceiling; long PDF extractions need more than 400 tokens.
LLM_MAX_TOKENS=4096

# Patient database connection URL (postgresql://user:password@host/db?sslmode=require).
# Used by scripts/run_service.py; auth must use a separate database.
AUTH_DATABASE_URL=

# Used by the root compose.yaml for the two local PostgreSQL containers.
LOCAL_POSTGRES_PASSWORD=

# Optional Langfuse tracing. Missing credentials disable export without blocking analysis.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
LANGFUSE_TRACING_ENVIRONMENT=development
OBSERVABILITY_ENABLED=true
# metadata (default) suppresses prompts, responses and graph state on export.
# synthetic enables content capture: use only with synthetic fixtures.
OBSERVABILITY_CONTENT_MODE=metadata
