# Gmail OAuth client, downloaded from Google Cloud Console as a Desktop app.
# Both default to this folder, so they only need setting when the files live
# elsewhere — a mounted secret in a container, for instance.
GMAIL_CREDENTIALS_PATH=D:\Aragen Assignment\Clinical-Lab-Result-Analyzer-Aragen-\email_service\credentials.json
GMAIL_TOKEN_PATH=

# Browser origins allowed to call this service. patientService calls it
# server-to-server and is unaffected by this.
CORS_ORIGINS=http://localhost:5173

# Raw size ceiling for an attachment, before base64 encoding inflates it by
# roughly a third. Gmail rejects finished messages over 25 MB.
EMAIL_MAX_ATTACHMENT_MB=18

LOG_LEVEL=INFO
