# Vision model, served over an OpenAI-compatible API.
#
# VLM_* wins when set; otherwise the INFERENCE_* names are used, so this file
# can be a copy of the analyzer's .env when both point at the same provider.

VLM_BASE_URL=
VLM_API_KEY=
# Must be vision-capable: every tile agent sends an image.
VLM_MODEL=zai-org/glm-5.3-flash

# Used when the VLM_* equivalents above are blank.
INFERENCE_BASE_URL=https://api.hpc-ai.com/inference/v1
INFERENCE_API_KEY=

# GLM-5.3 is a reasoning model and spends tokens thinking before it answers.
# Too little headroom and the reply comes back empty. max_tokens is a ceiling
# rather than a spend, so a generous value costs nothing on the calls that do
# not need it, while too small a one costs a whole call.
VLM_REASONING_HEADROOM=3072
# An empty reply is retried with double the budget, so a second attempt differs
# from the first.
VLM_ATTEMPTS=2
VLM_TIMEOUT_SECONDS=120

# Fan-out. Tiles per side: 2 -> a 2x2 grid, so four tile agents. Each tile runs
# its own tool loop, so this squares the cost of a run.
TILE_GRID=2
# Tool calls allowed per agent before it must answer. Per-agent model calls are
# this plus one.
MAX_TOOL_STEPS=2
# The image tool server is a subprocess; if it dies at import there is nothing
# to wait for, so the wait is bounded.
MCP_START_TIMEOUT=30

# Images are base64-encoded into the request, so this bounds the payload.
VLM_MAX_IMAGE_SIDE=1024

CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# Set to also write the run log to a file.
VLM_LOG_FILE=
